{
  "name": "@sc/user-tracking-client",
  "version": "0.0.2-beta.1",
  "description": "User Tracking Api Client",
  "main": "./dist/index.js",
  "typings": "./dist/index.d.ts",
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix  && prettier --write '{src}/**/*.ts'",
    "prebuild": "rimraf dist",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "jest",
    "test-coverage": "jest --collect-coverage",
    "reg": "npm set registry https://npm.lumigame.com",
    "pub": "tsc && npm publish --registry https://npm.lumigame.com",
    "betaver": "npm version prerelease --preid beta",
    "pubbeta": "tsc && npm publish --registry https://npm.lumigame.com --tag beta",
    "semantic-release": "semantic-release"
  },
  "jestSonar": {
    "reportPath": "reports",
    "reportFile": "test-reporter.xml",
    "indent": 4
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://git3.nexdev.net/l1/backend-services/user-tracking-api.git"
  },
  "keywords": [
    "user-tracking",
    "user-tracking-client",
    "sc-user-tracking-client"
  ],
  "author": {
    "email": "pentagon@sabawork.com",
    "name": "pentagon"
  },
  "license": "ISC",
  "dependencies": {
    "axios": "^1.11.0",
    "axios-retry": "^4.0.0"
  },
  "devDependencies": {
    "rimraf": "^3.0.2",
    "typescript": "5.3.2"
  }
}
